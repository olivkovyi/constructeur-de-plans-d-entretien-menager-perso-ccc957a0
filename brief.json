  footer ul {\n            list-style: none;\n            padding: 0;\n            display: flex;\n            flex-wrap: wrap;\n            justify-content: center;\n            gap: 10px;\n        }\n\n        footer li {\n            background-color: #3a3a3a;\n            padding: 8px 15px;\n            border-radius: 20px;\n            font-size: 0.85em;\n            color: #aaa;\n        }\n    </style>\n    <meta name=\"robots\" content=\"index, follow\">\n    <link rel=\"canonical\" href=\"https://constructeur-de-plans-d-entretien-menager-perso-ccc957a0.onrender.com\">\n    <meta property=\"og:title\" content=\"Constructeur de Plans d&#x27;Entretien Ménager Personnalisés\">\n    <meta property=\"og:description\" content=\"Générez un calendrier d\">\n    <meta property=\"og:url\" content=\"https://constructeur-de-plans-d-entretien-menager-perso-ccc957a0.onrender.com\">\n    <meta property=\"og:type\" content=\"website\">\n    <script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"WebApplication\", \"name\": \"Constructeur de Plans d'Entretien Ménager Personnalisés\", \"description\": \"Générez un calendrier d\", \"url\": \"https://constructeur-de-plans-d-entretien-menager-perso-ccc957a0.onrender.com\", \"applicationCategory\": \"UtilityApplication\", \"operatingSystem\": \"Web Browser\"}</script>\n</head>\n<body data-site-slug=\"constructeur-de-plans-d-entretien-menager-perso-ccc957a0\" data-runtime-mode=\"document_generator\">\n    <header>\n        <h1>Simplifiez l'Entretien de Votre Foyer</h1>\n        <p>Générez un calendrier d'entretien hebdomadaire, mensuel et saisonnier adapté à votre domicile et à vos habitudes de vie. Transformez une corvée en plaisir organisé.</p>\n    </header>\n\n    <div class=\"container\">\n        <div class=\"card\">\n            <h2>Votre Plan sur Mesure</h2>\n            <form id=\"tool-form\">\n                <label for=\"room-count\">Nombre de pièces principales (hors SDB/WC) :</label>\n                <input type=\"number\" id=\"room-count\" value=\"3\" min=\"1\" max=\"10\" required>\n\n                <label for=\"occupants\">Nombre d'occupants :</label>\n                <input type=\"number\" id=\"occupants\" value=\"2\" min=\"1\" max=\"8\" required>\n\n                <label for=\"pets\">Avez-vous des animaux de compagnie ?</label>\n                <select id=\"pets\">\n                    <option value=\"none\">Non</option>\n                    <option value=\"one\">Un</option>\n                    <option value=\"multiple\">Plusieurs</option>\n                </select>\n\n                <label for=\"house-type\">Type de logement :</label>\n                <select id=\"house-type\">\n                    <option value=\"apartment\">Appartement</option>\n                    <option value=\"house\">Maison</option>\n                </select>\n\n                <label for=\"garden\">Avez-vous un jardin ou balcon conséquent ?</label>\n                <select id=\"garden\">\n                    <option value=\"no\">Non</option>\n                    <option value=\"yes\">Oui</option>\n                </select>\n\n                <div class=\"checkbox-group\">\n                    <label>Préférences spécifiques :</label>\n                    <div><input type=\"checkbox\" id=\"dust-sensitive\" value=\"poussiere\"> Sensible à la poussière</div>\n                    <div><input type=\"checkbox\" id=\"kids\" value=\"enfants\"> Enfants en bas âge</div>\n                    <div><input type=\"checkbox\" id=\"allergies\" value=\"allergies\"> Allergies connues</div>\n                </div>\n                \n                <button type=\"submit\" id=\"tool-submit\">Générer Mon Calendrier</button>\n            </form>\n        </div>\n\n        <div class=\"card\">\n            <h2>Votre Calendrier Personnalisé</h2>\n            <div id=\"tool-result\">\n                <h3 id=\"result-headline\">Votre routine d'entretien apparaîtra ici.</h3>\n                <p>Remplissez les informations à gauche et cliquez sur \"Générer Mon Calendrier\" pour découvrir un plan adapté à votre domicile.</p>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"cta-section\">\n        <h2>Passez à la Vitesse Supérieure</h2>\n        <p>Vous aimez votre nouveau plan ? Découvrez des outils et astuces pour rendre l'entretien encore plus simple et agréable.</p>\n        <div class=\"cta-buttons\">\n            <button data-affiliate-slot=\"smart-cleaning-tools\">Découvrir les Outils Malins</button>\n            <button data-affiliate-slot=\"eco-friendly-products\">Produits Éco-responsables</button>\n        </div>\n    </div>\n\n    <footer>\n        <h2>Recherches Fréquentes pour un Foyer Impeccable</h2>\n        <p>Trouvez les meilleures pratiques pour l'organisation et l'entretien de votre maison.</p>\n        <ul>\n            <li>planning ménage semaine</li>\n            <li>calendrier nettoyage maison pdf</li>\n            <li>routine ménage rapide</li>\n            <li>organisation tâches ménagères famille</li>\n            <li>astuces entretien appartement</li>\n            <li>produits ménagers écologiques</li>\n            <li>comment garder sa maison propre</li>\n            <li>fréquence nettoyage salle de bain</li>\n            <li>entretien cuisine facile</li>\n            <li>désencombrer sa maison étapes</li>\n            <li>guide ménage printemps</li>\n            <li>checklist ménage fin de bail</li>\n        </ul>\n    </footer>\n\n    <script>\n        document.getElementById('tool-form').addEventListener('submit', function(event) {\n            event.preventDefault();\n\n            const roomCount = parseInt(document.getElementById('room-count').value);\n            const occupants = parseInt(document.getElementById('occupants').value);\n            const pets = document.getElementById('pets').value;\n            const houseType = document.getElementById('house-type').value;\n            const garden = document.getElementById('garden').value;\n            const dustSensitive = document.getElementById('dust-sensitive').checked;\n            const kids = document.getElementById('kids').checked;\n            const allergies = document.getElementById('allergies').checked;\n\n            let weeklyTasks = [];\n            let monthlyTasks = [];\n            let seasonalTasks = [];\n\n            // Base weekly tasks\n            weeklyTasks.push(\"Aspirer/laver les sols des pièces de vie\");\n            weeklyTasks.push(\"Nettoyer les surfaces de cuisine (plan de travail, évier)\");\n            weeklyTasks.push(\"Nettoyer les WC et lavabos\");\n            weeklyTasks.push(\"Vider les poubelles\");\n            weeklyTasks.push(\"Ranger et organiser les zones encombrées\");\n            weeklyTasks.push(\"Laver le linge et le plier\");\n\n            // Adjustments based on inputs\n            if (roomCount > 3 || occupants > 2) {\n                weeklyTasks.push(\"Passer l'aspirateur plus fréquemment dans les zones de passage\");\n            }\n            if (pets !== 'none') {\n                weeklyTasks.push(\"Aspirer les poils d'animaux (canapés, tapis)\");\n            }\n            if (kids) {\n                weeklyTasks.push(\"Ranger les jouets et désinfecter les surfaces fréquemment touchées\");\n            }\n            if (dustSensitive || allergies) {\n                weeklyTasks.push(\"Dépoussiérer les surfaces hautes et basses (meubles, étagères)\");\n            }\n            \n            // Monthly tasks\n            monthlyTasks.push(\"Nettoyer les miroirs et vitres\");\n            monthlyTasks.push(\"Dépoussiérer les luminaires et plinthes\");\n            monthlyTasks.push(\"Nettoyer la douche/baignoire en profondeur\");\n            monthlyTasks.push(\"Laver les tapis ou paillassons\");\n            monthlyTasks.push(\"Nettoyer les appareils électroménagers (micro-ondes, lave-vaisselle filtre)\");\n            if (houseType === 'house') {\